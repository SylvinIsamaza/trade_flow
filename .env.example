# Database URL - REQUIRED
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tradezella

# JWT Settings
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (optional)
REDIS_URL=

# MinIO Settings (optional - for file storage)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true
MINIO_BUCKET=tradezella

# Email/SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tradezella.com
SMTP_FROM_NAME=TradeZella
SMTP_USE_TLS=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App URL
APP_URL=http://localhost:3000

# Debug mode
DEBUG=true